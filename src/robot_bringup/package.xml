<?xml version="1.0"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files that bring up the robot hardware (cameras, dexterous hands, arms, data gloves).</description>
  <maintainer email="egosteer@outlook.com">EgoSteer Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>camera</exec_depend>
  <exec_depend>hand</exec_depend>
  <exec_depend>arm</exec_depend>
  <exec_depend>glove</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
