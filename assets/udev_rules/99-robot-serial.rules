# Stable /dev names for the project's serial USB devices.
# Matched by USB vendor/product (and interface for the shared quad-serial hand adapter),
# so the name follows the device regardless of physical port, hub, or reboot.
# Install with ./install.sh

# Data gloves — distinct product ids for left/right
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5739", SYMLINK+="glove_left"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", SYMLINK+="glove_right"

# Dexterous hands — one quad-serial adapter (1a86:55d5); interface number selects left/right
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d5", ENV{ID_USB_INTERFACE_NUM}=="00", SYMLINK+="hand_left"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d5", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="hand_right"
